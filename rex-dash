#!/usr/bin/env node
// rex-dash: a dashboard pane for Rex. Agent fleet (every Rex pane and its
// program status), your open PRs and review requests, and 30 days of Claude
// Code token usage by model.
//
//   rex-dash          live dashboard ([j/k] select an agent, [enter] jump to its pane, [r] refresh, [q] quit)
//   rex-dash --once   print one frame and exit
//   rex-dash --test   run the self-check
const { execFile } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');

const HOME = os.homedir();
const PROJECTS = path.join(HOME, '.claude', 'projects');
const DAYS = 30;

// ---- helpers
const sh = (cmd, args) => new Promise((resolve, reject) =>
  execFile(cmd, args, { maxBuffer: 64 << 20 }, (err, out, errOut) => err ? reject(new Error(errOut || err.message)) : resolve(out)));
const json = async (cmd, args) => JSON.parse(await sh(cmd, args));

const style = (code) => (s) => `\x1b[${code}m${s}\x1b[0m`;
const [dim, bold, red, green, yellow, blue, magenta, cyan] = [2, 1, 31, 32, 33, 34, 35, 36].map(style);
const ANSI = /(\x1b\[[0-9;]*m)/;
const vis = (s) => s.split(ANSI).filter((p) => !ANSI.test(p)).join('');
const pad = (s, n) => s + ' '.repeat(Math.max(0, n - vis(s).length));
const plain = (s) => String(s ?? '').replace(/[\x00-\x1f\x7f-\x9f]/g, ''); // text from programs and GitHub
const tilde = (p) => (p && p.startsWith(HOME) ? '~' + p.slice(HOME.length) : p || '');
const fmt = (n) => (n >= 1e9 ? (n / 1e9).toFixed(1) + 'B' : n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(n));
const ago = (t) => {
  const s = Math.max(0, ((Date.now() - new Date(t)) / 1000) | 0);
  return s < 60 ? `${s}s` : s < 3600 ? `${(s / 60) | 0}m` : s < 86400 ? `${(s / 3600) | 0}h` : `${(s / 86400) | 0}d`;
};

// Cut a styled line to w visible columns, keeping its escape codes.
function clip(s, w) {
  let out = '', n = 0;
  for (const part of s.split(ANSI)) {
    if (ANSI.test(part)) { out += part; continue; }
    for (const ch of part) {
      if (n >= w) return out + '\x1b[0m';
      out += ch; n++;
    }
  }
  return out;
}

// ---- fleet: every pane in every Rex session, with what its program reports
const RANK = { blocked: 0, error: 1, working: 2, done: 3, idle: 4 };
const STATE = {
  blocked: yellow('◆ blocked'), error: red('✗ error  '), working: green('● working'),
  done: cyan('✓ done   '), idle: dim('○ idle   '),
};

async function fleet() {
  const { sessions } = await json('rex', ['ls', '--json']);
  return Promise.all(sessions.map(async (s) => {
    const { blocks } = await json('rex', ['block', 'ls', '-s', s.session_id, '--json']);
    const panes = await Promise.all(blocks.map(async (b) => {
      const call = (m) => json('rex', ['block', 'call', '-s', s.session_id, '-b', b.block_id, m]).catch(() => ({}));
      const [proc, status, title] = await Promise.all([call('process'), call('program_status'), call('title')]);
      const rec = (status.records || []).sort((x, y) => (RANK[x.state] ?? 4) - (RANK[y.state] ?? 4))[0];
      return {
        session: s.label, sessionId: s.session_id, windowId: b.window_id, blockId: b.block_id,
        prog: proc.foreground?.name || b.label, cwd: proc.foreground?.cwd, title: title.title, rec,
      };
    }));
    return { label: s.label, panes };
  }));
}

function renderFleet(f) {
  const panes = f.flatMap((s) => s.panes);
  const n = (st) => panes.filter((p) => p.rec?.state === st).length;
  const out = [head('FLEET', `${f.length} sessions · ${panes.length} panes · ${green(n('working') + ' working')} · ${yellow(n('blocked') + ' blocked')}`)];
  for (const s of f) {
    out.push(bold(plain(s.label)));
    for (const p of s.panes) {
      if (!p.rec) { out.push(dim(`  · ${pad(plain(p.prog), 9)} ${tilde(p.cwd)}`)); continue; }
      const r = p.rec;
      const kind = r.state === 'blocked' && r.kind ? yellow(` (${plain(r.kind)})`) : '';
      const [mark, title] = p.blockId === sel ? [cyan('▸ '), bold(plain(p.title || r.title))] : ['  ', plain(p.title || r.title)];
      out.push(`${mark}${STATE[r.state] || STATE.idle}${kind} ${dim(pad(ago(r.updated_at), 3))} ${magenta(plain(r.effective_app || p.prog))}  ${title}`);
      out.push(dim(`              ${[plain(r.msg), tilde(p.cwd)].filter(Boolean).join(' · ')}`));
    }
  }
  return out;
}

// ---- PRs: open PRs you wrote, and PRs waiting on your review, across GitHub
const PR_QUERY = `query {
  mine: search(query: "is:pr is:open author:@me archived:false sort:updated-desc", type: ISSUE, first: 30) { issueCount nodes { ...pr } }
  review: search(query: "is:pr is:open review-requested:@me archived:false sort:updated-desc", type: ISSUE, first: 30) { issueCount nodes { ...pr } }
}
fragment pr on PullRequest {
  number title isDraft reviewDecision updatedAt repository { name }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}`;
const prs = async () => (await json('gh', ['api', 'graphql', '-f', `query=${PR_QUERY}`])).data;

const CI = { SUCCESS: green('✓'), FAILURE: red('✗'), ERROR: red('✗'), PENDING: yellow('◐'), EXPECTED: yellow('◐') };
const REVIEW = { APPROVED: green('approved'), CHANGES_REQUESTED: red('changes'), REVIEW_REQUIRED: yellow('review') };
const prLine = (p) => {
  const ci = CI[p.commits.nodes[0]?.commit.statusCheckRollup?.state] || dim('·');
  const tag = p.isDraft ? dim('draft') : REVIEW[p.reviewDecision] || dim('open');
  return `  ${ci} ${pad(tag, 8)} ${blue(`${plain(p.repository.name)}#${p.number}`)} ${plain(p.title)} ${dim(ago(p.updatedAt))}`;
};

function renderPRs(d) {
  return [
    head('REVIEW REQUESTS', `${d.review.issueCount} waiting on you`), ...d.review.nodes.slice(0, 10).map(prLine),
    head('MY PRS', `${d.mine.issueCount} open`), ...d.mine.nodes.map(prLine), // last: overflow falls off the bottom
  ];
}

// ---- usage: Claude Code tokens by model, from ~/.claude/projects transcripts
// One row per usage line: [message id, model, day, total tokens, output tokens].
function parseUsage(text) {
  const rows = [];
  for (const line of text.split('\n')) {
    if (!line.includes('"usage"')) continue;
    let e;
    try { e = JSON.parse(line); } catch { continue; }
    const m = e.message, u = m?.usage;
    if (!u || !m.model || m.model === '<synthetic>') continue;
    const total = (u.input_tokens || 0) + (u.output_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.cache_read_input_tokens || 0);
    rows.push([m.id || e.uuid, m.model, (e.timestamp || '').slice(0, 10), total, u.output_tokens || 0]);
  }
  return rows;
}

// A message with several content blocks repeats its usage on each line, so
// count each message id once.
function aggregate(rowLists, now = Date.now()) {
  const days = Array.from({ length: DAYS }, (_, i) => new Date(now - (DAYS - 1 - i) * 864e5).toISOString().slice(0, 10));
  const seen = new Set(), models = {}, daily = Object.fromEntries(days.map((d) => [d, 0]));
  for (const rows of rowLists) {
    for (const [id, model, day, total, out] of rows) {
      if (!(day in daily) || seen.has(id)) continue;
      seen.add(id);
      const m = (models[model] ||= [model, 0, 0]);
      m[1] += total; m[2] += out;
      daily[day] += total;
    }
  }
  return { models: Object.values(models).sort((a, b) => b[1] - a[1]), daily: days.map((d) => daily[d]) };
}

const fileCache = new Map(); // path -> { mtimeMs, rows }; only changed transcripts are reread
function usage() {
  const since = Date.now() - DAYS * 864e5, lists = [];
  for (const rel of fs.readdirSync(PROJECTS, { recursive: true })) {
    if (!rel.endsWith('.jsonl')) continue;
    const file = path.join(PROJECTS, rel);
    let st;
    try { st = fs.statSync(file); } catch { continue; }
    if (st.mtimeMs < since) continue;
    let hit = fileCache.get(file);
    if (!hit || hit.mtimeMs !== st.mtimeMs) fileCache.set(file, (hit = { mtimeMs: st.mtimeMs, rows: parseUsage(fs.readFileSync(file, 'utf8')) }));
    lists.push(hit.rows);
  }
  return aggregate(lists);
}

const SPARK = ' ▁▂▃▄▅▆▇█';
function renderUsage(u) {
  const max = Math.max(1, ...u.daily), top = u.models[0]?.[1] || 1;
  const out = [head(`USAGE · ${DAYS}d tokens`, cyan(u.daily.map((v) => SPARK[Math.round((v / max) * 8)]).join('')))];
  for (const [model, total, outTok] of u.models.slice(0, 8)) {
    out.push(`  ${pad(plain(model).replace(/^claude-/, ''), 18)} ${pad(fmt(total), 7)} ${dim(pad('out ' + fmt(outTok), 11))} ${cyan('▬'.repeat(Math.max(1, Math.round((total / top) * 20))))}`);
  }
  return out;
}

// ---- screen
const state = {}, busy = new Set();
const head = (title, extra = '') => `\n${bold(cyan(title))}  ${extra}`;
const firstLine = (e) => String(e.message || e).trim().split('\n')[0];
const ONCE = process.argv.includes('--once');

// ---- jump: j/k pick an agent, enter shows its pane in the Rex app
let sel = null, flash = null; // sel is a block ID, so it survives refreshes
const agents = () => (state.fleet || []).flatMap((s) => s.panes).filter((p) => p.rec);
const say = (text) => { flash = { text, until: Date.now() + 4e3 }; draw(); };

function move(d) {
  const a = agents();
  if (!a.length) return;
  const i = a.findIndex((p) => p.blockId === sel);
  sel = a[i < 0 ? 0 : Math.min(a.length - 1, Math.max(0, i + d))].blockId;
  draw();
}

async function jump() {
  const p = agents().find((x) => x.blockId === sel);
  if (!p) return say(dim('pick an agent with j/k first'));
  try {
    // With several Rex apps connected, set REX_CLIENT to pick one.
    await sh('rex', ['do', 'session.select', `session_id=${p.sessionId}`, `window_id=${p.windowId}`]);
    await sh('rex', ['focus', '-s', p.sessionId, p.blockId]);
    say(green(`→ ${plain(p.session)}`));
  } catch (e) {
    say(red(plain(firstLine(e))));
  }
}

function frame() {
  const section = (key, render, loading) =>
    state[key + 'Err'] ? [head(key.toUpperCase()), red('  ' + plain(state[key + 'Err']))] : state[key] ? render(state[key]) : [head(key.toUpperCase()), dim('  ' + loading)];
  return [
    `${bold(cyan('REX // COCKPIT'))} ${dim('·')} ${new Date().toString().slice(0, 21)}${ONCE ? '' : dim('   [j/k] select  [enter] jump  [r] refresh  [q] quit')}` +
      (flash && Date.now() < flash.until ? `  ${flash.text}` : ''),
    ...section('fleet', renderFleet, 'asking Rex…'),
    ...section('usage', renderUsage, `reading ${tilde(PROJECTS)}…`),
    ...section('prs', renderPRs, 'asking GitHub…'),
  ].flatMap((l) => l.split('\n'));
}

function draw() {
  if (ONCE) return;
  const w = process.stdout.columns || 100, h = process.stdout.rows || 50;
  // w - 1: erasing to end of line from the last column would wipe its character
  process.stdout.write('\x1b[H' + frame().slice(0, h).map((l) => clip(l, w - 1) + '\x1b[K').join('\n') + '\x1b[J');
}

async function refresh(key, fn) {
  if (busy.has(key)) return;
  busy.add(key);
  try { state[key] = await fn(); delete state[key + 'Err']; } catch (e) { state[key + 'Err'] = firstLine(e); }
  busy.delete(key);
  draw();
}

const SOURCES = { fleet: [fleet, 3e3], prs: [prs, 60e3], usage: [async () => usage(), 300e3] };
const refreshAll = () => Object.entries(SOURCES).map(([k, [fn]]) => refresh(k, fn));

async function main() {
  if (ONCE) {
    await Promise.all(refreshAll());
    return console.log(frame().join('\n'));
  }
  const quit = () => { process.stdout.write('\x1b[?25h\x1b[?1049l'); process.exit(0); };
  process.stdout.write('\x1b[?1049h\x1b[?25l');
  process.on('SIGINT', quit).on('SIGTERM', quit).on('SIGHUP', quit);
  process.stdout.on('resize', draw);
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true).resume().on('data', (k) => {
      const s = k.toString();
      if (s === 'q' || s === '\x03') quit();
      if (s === 'r') refreshAll();
      if (s === 'j' || s === '\x1b[B') move(1);
      if (s === 'k' || s === '\x1b[A') move(-1);
      if (s === '\r') jump();
    });
  }
  draw();
  await refresh('fleet', fleet); // the usage scan blocks the event loop, so show the fleet first
  refreshAll();
  for (const [k, [fn, every]] of Object.entries(SOURCES)) setInterval(() => refresh(k, fn), every);
  setInterval(draw, 1e3); // keep the clock and the "ago" columns moving
}

if (process.argv.includes('--test')) {
  const assert = require('node:assert');
  const now = Date.parse('2026-11-01T12:00:00Z');
  const line = (id, out, ts = '2026-11-01T01:00:00Z') => JSON.stringify({ timestamp: ts, message: { id, model: 'claude-x', usage: { input_tokens: 1, output_tokens: out } } });
  const text = [line('a', 5), line('a', 5), line('b', 2), line('old', 9, '2026-01-01T00:00:00Z'), 'not json "usage"'].join('\n');
  const u = aggregate([parseUsage(text)], now);
  assert.deepStrictEqual(u.models, [['claude-x', 9, 7]]); // a counted once, old outside the window
  assert.strictEqual(u.daily.at(-1), 9);
  assert.strictEqual(vis(clip(red('hello') + ' world', 3)), 'hel');
  assert.strictEqual(vis(pad(green('ok'), 4)), 'ok  ');
  console.log('ok');
} else {
  main();
}
