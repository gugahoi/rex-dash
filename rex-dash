  assert.ok(/^wt-[0-9a-f]{8}$/.test(key) && key !== cacheKey({ roots: ['/s/wt'] }) && cacheKey(null) === 'all');
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'rex-dash-'));
  cacheDir = path.join(tmp, 'cache');
  writeCache('a.json', { a: 1 });
  assert.deepStrictEqual(readCache('a.json'), { version: CACHE_VERSION, a: 1 });
  fs.writeFileSync(path.join(cacheDir, 'old.json'), JSON.stringify({ version: 0, a: 1 }));
  assert.deepStrictEqual([readCache('old.json'), readCache('none.json')], [null, null]); // another version, or none
  // A new dashboard reuses the saved rows of a transcript whose mtime holds, unless the repo grew a root they don't cover.
  const projects = path.join(tmp, 'projects'), log = path.join(projects, 'p', 's.jsonl'), at = Math.floor(Date.now() / 1000);
  const today = (id, cwd) => JSON.stringify({ timestamp: new Date().toISOString(), cwd, message: { id, model: 'claude-x', usage: { output_tokens: 1 } } });
  fs.mkdirSync(path.dirname(log), { recursive: true });
  fs.writeFileSync(log, [today('p', '/r/a'), today('q', '/r/b')].join('\n'));
  fs.utimesSync(log, at, at);
  repo = { roots: ['/r/a'] };
  assert.deepStrictEqual(usage(projects).models, [['claude-x', 1, 1]]);
  fs.writeFileSync(log, '');
  fs.utimesSync(log, at, at);
  transcripts = null;
  assert.deepStrictEqual(usage(projects).models, [['claude-x', 1, 1]]); // read from the cache, not the emptied file
  repo = { roots: ['/r/a', '/r/b'] }; transcripts = null;
  assert.deepStrictEqual(usage(projects).models, []); // /r/b wasn't covered, so the file is read again
  fs.rmSync(tmp, { recursive: true });
  repo = cacheDir = transcripts = null;
  assert.strictEqual(vis(clip(red('hello') + ' world', 3)), 'hel');
  assert.strictEqual(vis(pad(green('ok'), 4)), 'ok  ');
  for (const [name, shader] of Object.entries(SHADERS)) {
    if (!shader) continue;
    for (const [x, y, t] of [[0, 0, 0], [37, 5, 12.3], [200, 60, 999]]) {
      assert.ok(shader(x, y, t).every((v) => Number.isInteger(v) && v >= 0 && v <= 255), `${name} at ${x},${y},${t}`);
    }
  }
  Object.assign(fx, { shader: 'off', effect: 'scanlines' });
  assert.ok(paint(red('a') + 'b', 1, 80, 0).includes('\x1b[0m' + bg(SCANLINE) + 'b')); // the row colour survives resets
  Object.assign(fx, { shader: 'aurora', effect: 'bloom' });
  assert.strictEqual(vis(paint(`x${shaded('ab')}`, 0, 80, 0)), 'xab\x1b[K'); // vis keeps the erase-line code
  const issue = (links) => ({
    number: 7, title: 'fix it', updatedAt: new Date().toISOString(), repository: { name: 'r' }, author: { login: 'ann' },
    comments: { totalCount: 0 }, milestone: null, assignees: { nodes: [] }, labels: { nodes: [] }, closedByPullRequestsReferences: { nodes: links },
  });
  const linked = [{ number: 3, state: 'CLOSED' }, { number: 2, state: 'OPEN', isDraft: true }, { number: 1, state: 'MERGED' }];
  const starts = (links, glyph) => assert.ok(issueLines(issue(links))[0].startsWith(`  ${glyph} ${blue('r#7')} `));
  starts(linked, yellow('⇄')); // a draft beats merged and closed PRs
  starts([...linked, { number: 4, state: 'OPEN' }], green('⇄')); // an open PR beats all
  starts([], dim('·')); // no linked PR, no glyph
  sel = 'r#7';
  assert.ok(issueLines(issue([]))[0].startsWith(MARK + dim('·'))); // the selected issue is marked
  sel = null;
  // Rows below the title, keys and band scroll up just enough for the selection's two lines to show.
  const screen = ['title', 'keys', BAND, 'a', 'b', 'c', `${MARK}x`, 'y', 'z'];
  assert.deepStrictEqual(fit([...screen], 8), ['title', 'keys', BAND, 'b', 'c', `${MARK}x`, 'y']);
  assert.deepStrictEqual(fit([...screen], 6), ['title', 'keys', BAND, `${MARK}x`, 'y']);
  assert.deepStrictEqual(fit(screen.map((l) => l.replace(MARK, '')), 6), ['title', 'keys', BAND, 'a', 'b']); // no selection, no scroll
  console.log('ok');
} else {
  main();
}
