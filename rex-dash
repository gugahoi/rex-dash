#!/usr/bin/env node
// rex-dash: a dashboard pane for Rex. Agent fleet (every Rex pane and its
// program status), your open PRs and review requests, open issues, and 30
// days of Claude Code token usage by model.
//
//   rex-dash          live dashboard ([j/k] select an agent or issue, [enter] jump to the agent's pane
//                     or open the issue's worktree with wt, [s] cycle shader, [e] cycle effects,
//                     [r] refresh, [q] quit)
//   rex-dash --once   print one frame and exit
//   rex-dash --test   run the self-check
//
// Each repo keeps a cache in ~/.cache/rex-dash, so the dashboard starts on the last data it saw and
// refreshes from there.
const { execFile, spawn } = require('node:child_process');
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');

const HOME = os.homedir();
const PROJECTS = path.join(HOME, '.claude', 'projects');
const DAYS = 30;

// ---- helpers
const sh = (cmd, args, opts = {}) => new Promise((resolve, reject) =>
  execFile(cmd, args, { maxBuffer: 64 << 20, ...opts }, (err, out, errOut) => err ? reject(new Error(errOut || err.message)) : resolve(out)));
const json = async (cmd, args) => JSON.parse(await sh(cmd, args));

const style = (code) => (s) => `\x1b[${code}m${s}\x1b[0m`;
const [dim, bold, red, green, yellow, blue, magenta, cyan] = [2, 1, 31, 32, 33, 34, 35, 36].map(style);
const ANSI = /(\x1b\[[0-9;]*m)/;
const vis = (s) => s.split(ANSI).filter((p) => !ANSI.test(p)).join('').replace(/[\x01\x02]/g, '');
const pad = (s, n) => s + ' '.repeat(Math.max(0, n - vis(s).length));
// Text from programs and GitHub. Stripping control characters also keeps it
// from forging the \x01..\x04 markers paint() reads.
const plain = (s) => String(s ?? '').replace(/[\x00-\x1f\x7f-\x9f]/g, '');
const tilde = (p) => plain(p && p.startsWith(HOME) ? '~' + p.slice(HOME.length) : p || '');
const fmt = (n) => (n >= 1e9 ? (n / 1e9).toFixed(1) + 'B' : n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(n));
const ago = (t) => {
  const s = Math.max(0, ((Date.now() - new Date(t)) / 1000) | 0);
  return s < 60 ? `${s}s` : s < 3600 ? `${(s / 60) | 0}m` : s < 86400 ? `${(s / 3600) | 0}h` : `${(s / 86400) | 0}d`;
};

// Cut a styled line to w visible columns, keeping its escape codes.
function clip(s, w) {
  let out = '', n = 0;
  for (const part of s.split(ANSI)) {
    if (ANSI.test(part)) { out += part; continue; }
    for (const ch of part) {
      if (n >= w) return out + '\x1b[0m';
      out += ch; n++;
    }
  }
  return out;
}

// ---- repo: started inside a git repo, the cockpit shows only that repo.
// The repo's roots are its worktrees' folders. In the bare-plus-worktrees
// layout (<dir>/.bare) <dir> is a root too, so worktrees made later count.
// githubName() finds the GitHub name separately, since gh needs a network round trip for it.
let repo = null; // { roots, gh: 'owner/name' or null, name }
async function detectRepo(dir) {
  let list;
  try { list = await sh('git', ['-C', dir, 'worktree', 'list', '--porcelain']); } catch { return null; }
  const roots = [];
  for (const entry of list.trim().split('\n\n')) {
    const p = entry.match(/^worktree (.+)$/m)?.[1];
    if (!p) continue;
    const root = /^bare$/m.test(entry) && path.basename(p) === '.bare' ? path.dirname(p) : p;
    try { roots.push(fs.realpathSync(root)); } catch { roots.push(root); } // /tmp is /private/tmp on macOS
  }
  return { roots, gh: null, name: path.basename(roots[0]) };
}
const githubName = (dir) => sh('gh', ['repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner'], { cwd: dir }).then((s) => s.trim(), () => null);
const named = (gh) => Object.assign(repo, { gh, name: gh || path.basename(repo.roots[0]) });
const within = (roots, p) => !!p && roots.some((r) => p === r || p.startsWith(r + '/'));
const inRepo = (p) => !repo || within(repo.roots, p);

// ---- cache: each repo has its own folder in $XDG_CACHE_HOME/rex-dash (~/.cache/rex-dash), and so does
// everything, outside a repo. It holds the last sections, the repo's GitHub name and the usage rows read
// from transcripts, so a new dashboard shows the last data at once and refreshes it in the background.
const CACHE = path.join(process.env.XDG_CACHE_HOME || path.join(HOME, '.cache'), 'rex-dash'), CACHE_VERSION = 1;
let cacheDir = null;
// Every worktree of a repo lists the same first root, so they share a folder.
const cacheKey = (r) => !r ? 'all'
  : `${path.basename(r.roots[0]).replace(/[^\w.-]/g, '_')}-${crypto.createHash('sha1').update(r.roots[0]).digest('hex').slice(0, 8)}`;
function readCache(name) {
  try {
    const c = JSON.parse(fs.readFileSync(path.join(cacheDir, name), 'utf8'));
    return c.version === CACHE_VERSION ? c : null;
  } catch { return null; }
}
// Written to a temporary file and renamed, so two dashboards in one repo never leave a half-written file.
function writeCache(name, data) {
  if (!cacheDir) return;
  const file = path.join(cacheDir, name), tmp = `${file}.${process.pid}`;
  try {
    fs.mkdirSync(cacheDir, { recursive: true });
    fs.writeFileSync(tmp, JSON.stringify({ version: CACHE_VERSION, ...data }));
    fs.renameSync(tmp, file);
  } catch { fs.rmSync(tmp, { force: true }); } // a cache that can't be saved only makes the next start slower
}

// ---- fleet: every pane in every Rex session (in the repo), with what its program reports
const RANK = { blocked: 0, error: 1, working: 2, done: 3, idle: 4 };
const STATE = {
  blocked: yellow('◆ blocked'), error: red('✗ error  '), working: green('● working'),
  done: cyan('✓ done   '), idle: dim('○ idle   '),
};

async function fleet() {
  const { sessions } = await json('rex', ['ls', '--json']);
  return Promise.all(sessions.map(async (s) => {
    const { blocks } = await json('rex', ['block', 'ls', '-s', s.session_id, '--json']);
    const panes = await Promise.all(blocks.map(async (b) => {
      const call = (m) => json('rex', ['block', 'call', '-s', s.session_id, '-b', b.block_id, m]).catch(() => ({}));
      const [proc, status, title] = await Promise.all([call('process'), call('program_status'), call('title')]);
      const rec = (status.records || []).sort((x, y) => (RANK[x.state] ?? 4) - (RANK[y.state] ?? 4))[0];
      return {
        session: s.label, sessionId: s.session_id, windowId: b.window_id, blockId: b.block_id,
        prog: proc.foreground?.name || b.label, cwd: proc.foreground?.cwd, title: title.title, rec,
      };
    }));
    return { label: s.label, panes: panes.filter((p) => inRepo(p.cwd)) };
  })).then((all) => all.filter((s) => s.panes.length));
}

function renderFleet(f) {
  const panes = f.flatMap((s) => s.panes);
  const n = (st) => panes.filter((p) => p.rec?.state === st).length;
  const out = [head('FLEET', `${f.length} sessions · ${panes.length} panes · ${green(n('working') + ' working')} · ${yellow(n('blocked') + ' blocked')}`)];
  for (const s of f) {
    out.push(bold(plain(s.label)));
    for (const p of s.panes) {
      if (!p.rec) { out.push(dim(`  · ${pad(plain(p.prog), 9)} ${tilde(p.cwd)}`)); continue; }
      const r = p.rec;
      const kind = r.state === 'blocked' && r.kind ? yellow(` (${plain(r.kind)})`) : '';
      const [mark, title] = p.blockId === sel ? [MARK, bold(plain(p.title || r.title))] : ['  ', plain(p.title || r.title)];
      out.push(`${mark}${STATE[r.state] || STATE.idle}${kind} ${dim(pad(ago(r.updated_at), 3))} ${magenta(plain(r.effective_app || p.prog))}  ${title}`);
      out.push(dim(`              ${[plain(r.msg), tilde(p.cwd)].filter(Boolean).join(' · ')}`));
    }
  }
  return out;
}

// ---- PRs: open PRs you wrote, and PRs waiting on your review, across GitHub (or in the repo)
const prQuery = (scope) => `query {
  mine: search(query: "is:pr is:open author:@me archived:false sort:updated-desc${scope}", type: ISSUE, first: 30) { issueCount nodes { ...pr } }
  review: search(query: "is:pr is:open review-requested:@me archived:false sort:updated-desc${scope}", type: ISSUE, first: 30) { issueCount nodes { ...pr } }
}
fragment pr on PullRequest {
  number title isDraft reviewDecision updatedAt repository { name }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}`;
async function prs() {
  if (repo && !repo.gh) throw new Error('no GitHub remote, so no PRs');
  return (await json('gh', ['api', 'graphql', '-f', `query=${prQuery(repo ? ` repo:${repo.gh}` : '')}`])).data;
}

const CI = { SUCCESS: green('✓'), FAILURE: red('✗'), ERROR: red('✗'), PENDING: yellow('◐'), EXPECTED: yellow('◐') };
const REVIEW = { APPROVED: green('approved'), CHANGES_REQUESTED: red('changes'), REVIEW_REQUIRED: yellow('review') };
const prLine = (p) => {
  const ci = CI[p.commits.nodes[0]?.commit.statusCheckRollup?.state] || dim('·');
  const tag = p.isDraft ? dim('draft') : REVIEW[p.reviewDecision] || dim('open');
  return `  ${ci} ${pad(tag, 8)} ${blue(`${plain(p.repository.name)}#${p.number}`)} ${plain(p.title)} ${dim(ago(p.updatedAt))}`;
};

function renderPRs(d) {
  return [
    head('REVIEW REQUESTS', `${d.review.issueCount} waiting on you`), ...d.review.nodes.slice(0, 10).map(prLine),
    head('MY PRS', `${d.mine.issueCount} open`), ...d.mine.nodes.slice(0, 10).map(prLine),
  ];
}

// ---- issues: open issues in the repo, or assigned to you across GitHub, most recently updated first
const issueQuery = (scope) => `query {
  issues: search(query: "is:issue is:open ${scope} archived:false sort:updated-desc", type: ISSUE, first: 30) { issueCount nodes { ...issue } }
}
fragment issue on Issue {
  number title updatedAt repository { name } author { login } comments { totalCount } milestone { title }
  assignees(first: 5) { nodes { login } }
  labels(first: 10) { nodes { name color } }
  closedByPullRequestsReferences(first: 5, includeClosedPrs: true) { nodes { number state isDraft } }
}`;
async function issues() {
  if (repo && !repo.gh) throw new Error('no GitHub remote, so no issues');
  return (await json('gh', ['api', 'graphql', '-f', `query=${issueQuery(repo ? `repo:${repo.gh}` : 'assignee:@me')}`])).data.issues;
}

// The glyph for an issue's linked PRs (the ones that would close it), coloured
// by the best of them: open, then draft, merged, closed.
const LINK = { OPEN: green('⇄'), DRAFT: yellow('⇄'), MERGED: magenta('⇄'), CLOSED: dim('⇄') };
const LINK_RANK = Object.keys(LINK);
// A label as a chip in its GitHub colour, lifted when dark so it reads on the dark pane.
function chip({ name, color }) {
  const c = /^[0-9a-f]{6}$/i.test(color) ? hex('#' + color) : [128, 128, 128];
  const lum = (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255;
  return `${bg(mix(BASE, c, 0.25))}${fg(mix(c, [255, 255, 255], Math.max(0, 0.6 - lum)))} ${plain(name)} \x1b[0m`;
}
const issueLines = (i) => {
  const links = i.closedByPullRequestsReferences.nodes
    .map((p) => ({ number: p.number, state: p.state === 'OPEN' && p.isDraft ? 'DRAFT' : p.state }))
    .sort((a, b) => LINK_RANK.indexOf(a.state) - LINK_RANK.indexOf(b.state));
  const who = i.assignees.nodes.map((a) => plain(a.login)).join(', '), n = i.comments.totalCount;
  const meta = [
    `by ${plain(i.author?.login || 'ghost')}`, // a deleted account has no author
    who && `assigned ${who}`,
    n && `${n} comment${n === 1 ? '' : 's'}`,
    i.milestone && `milestone ${plain(i.milestone.title)}`,
    links.length && `pr ${links.map((p) => '#' + p.number).join(' ')}`,
  ].filter(Boolean).join(' · ');
  const [mark, title] = issueKey(i) === sel ? [MARK, bold(plain(i.title))] : ['  ', plain(i.title)];
  return [
    `${mark}${LINK[links[0]?.state] || dim('·')} ${blue(issueKey(i))} ${title} ${dim(ago(i.updatedAt))}`,
    `    ${[...i.labels.nodes.map(chip), dim(meta)].join(' ')}`,
  ];
};

function renderIssues(d) {
  // last: overflow falls off the bottom
  return [head('ISSUES', `${d.issueCount} ${repo ? 'open' : 'assigned to you'}`), ...d.nodes.flatMap(issueLines)];
}

// ---- usage: Claude Code tokens by model, from ~/.claude/projects transcripts
// One row per usage line: [message id, model, day, total tokens, output tokens, session folder].
function parseUsage(text) {
  const rows = [];
  for (const line of text.split('\n')) {
    if (!line.includes('"usage"')) continue;
    let e;
    try { e = JSON.parse(line); } catch { continue; }
    const m = e.message, u = m?.usage;
    if (!u || !m.model || m.model === '<synthetic>') continue;
    const total = (u.input_tokens || 0) + (u.output_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.cache_read_input_tokens || 0);
    rows.push([m.id || e.uuid, m.model, (e.timestamp || '').slice(0, 10), total, u.output_tokens || 0, e.cwd]);
  }
  return rows;
}

// A message with several content blocks repeats its usage on each line, so
// count each message id once. keep(folder) picks the sessions to count.
function aggregate(rowLists, now = Date.now(), keep = inRepo) {
  const days = Array.from({ length: DAYS }, (_, i) => new Date(now - (DAYS - 1 - i) * 864e5).toISOString().slice(0, 10));
  const seen = new Set(), models = {}, daily = Object.fromEntries(days.map((d) => [d, 0]));
  for (const rows of rowLists) {
    for (const [id, model, day, total, out, cwd] of rows) {
      if (!(day in daily) || seen.has(id) || !keep(cwd)) continue;
      seen.add(id);
      const m = (models[model] ||= [model, 0, 0]);
      m[1] += total; m[2] += out;
      daily[day] += total;
    }
  }
  return { models: Object.values(models).sort((a, b) => b[1] - a[1]), daily: days.map((d) => daily[d]) };
}

// The rows of a transcript worth keeping: in the repo, not before the window's first day (which only
// moves on), and each message once. aggregate() counts the same rows from these as from all of them.
function cacheRows(rows, first) {
  const seen = new Set();
  return rows.filter(([id, , day, , , cwd]) => day >= first && inRepo(cwd) && !seen.has(id) && seen.add(id));
}

// path -> [mtimeMs, rows]: only changed transcripts are reread, and the rows are saved for the next
// dashboard. Rows saved for roots that cover the repo's still hold; a root outside them means reading again.
let transcripts = null;
function usage(dir = PROJECTS) {
  const now = Date.now(), since = now - DAYS * 864e5, first = new Date(now - (DAYS - 1) * 864e5).toISOString().slice(0, 10);
  if (!transcripts) {
    const c = readCache('transcripts.json');
    transcripts = new Map(c && (!repo || repo.roots.every((r) => within(c.roots || [], r))) ? Object.entries(c.files) : []);
  }
  const next = new Map(), lists = [];
  let reread = false;
  for (const rel of fs.readdirSync(dir, { recursive: true })) {
    if (!rel.endsWith('.jsonl')) continue;
    const file = path.join(dir, rel);
    let st;
    try { st = fs.statSync(file); } catch { continue; }
    if (st.mtimeMs < since) continue;
    let hit = transcripts.get(file);
    if (!hit || hit[0] !== st.mtimeMs) { hit = [st.mtimeMs, cacheRows(parseUsage(fs.readFileSync(file, 'utf8')), first)]; reread = true; }
    next.set(file, hit);
    lists.push(hit[1]);
  }
  if (reread || next.size !== transcripts.size) writeCache('transcripts.json', { roots: repo?.roots, files: Object.fromEntries(next) });
  transcripts = next; // transcripts gone, or out of the window, drop out
  return aggregate(lists, now);
}

const SPARK = ' ▁▂▃▄▅▆▇█';
function renderUsage(u) {
  const max = Math.max(1, ...u.daily), top = u.models[0]?.[1] || 1;
  if (!u.models.length) return [head(`USAGE · ${DAYS}d tokens`), dim(`  no Claude Code sessions in the last ${DAYS} days`)];
  const out = [head(`USAGE · ${DAYS}d tokens`, shaded(u.daily.map((v) => SPARK[Math.round((v / max) * 8)]).join('')))];
  for (const [model, total, outTok] of u.models.slice(0, 8)) {
    out.push(`  ${pad(plain(model).replace(/^claude-/, ''), 18)} ${pad(fmt(total), 7)} ${dim(pad('out ' + fmt(outTok), 11))} ${shaded('▬'.repeat(Math.max(1, Math.round((total / top) * 20))))}`);
  }
  return out;
}

// ---- screen
const state = {}, busy = new Map(); // busy: section -> its refresh in flight
const fetched = {}, stale = new Set(); // when each section was fetched; the sections still showing cached data
const head = (title, extra = '') => `\n${bold(shaded(title))}  ${extra}`;
const firstLine = (e) => String(e.message || e).trim().split('\n')[0];
const ONCE = process.argv.includes('--once');

// ---- effects: a shader colours the bands, headings and charts, bloom puts a
// glow behind coloured text, and scanlines darken every other row. It's all
// truecolor text, redrawn at 10 fps, and draw() only rewrites rows that changed.
const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const mix = (a, b, k) => a.map((v, i) => Math.round(v + (b[i] - v) * k));
const ramp = (stops, k) => {
  k = Math.min(1, Math.max(0, k)) * (stops.length - 1);
  const i = Math.min(stops.length - 2, k | 0);
  return mix(stops[i], stops[i + 1], k - i);
};
const AURORA = ['#0f9b8e', '#14f195', '#00d4ff', '#9945ff'].map(hex);
const EMBER = ['#ff2e63', '#ff7a3c', '#ffd23f'].map(hex);
const RAINBOW = ['#ff5f6d', '#ffc371', '#47e891', '#3ab0ff', '#c86dd7', '#ff5f6d'].map(hex); // ends where it starts, so it cycles
// Each shader maps a cell (x, y) at time t seconds to a colour.
const SHADERS = {
  aurora: (x, y, t) => ramp(AURORA, (Math.sin(x * 0.11 + t * 0.9) + 0.5 * Math.sin(x * 0.23 - t * 1.4 + y * 0.5) + 1.5) / 3),
  plasma: (x, y, t) => ramp(RAINBOW, ((Math.sin(x * 0.15 + t) + Math.sin(x * 0.07 + y * 0.6 - t * 1.6) + Math.sin(Math.hypot(x - 40, y * 2 - 20) * 0.12 - t * 1.2)) / 6 + 0.5 + t * 0.05) % 1),
  ember: (x, y, t) => ramp(EMBER, (Math.sin(x * 0.13 - t * 1.1) * Math.cos(x * 0.05 + t * 0.7 + y * 0.3) + 1) / 2),
  off: null,
};
const EFFECTS = ['bloom+scanlines', 'bloom', 'scanlines', 'off'];
// Glows are mixed over BASE, the background scanlines paint. Without
// scanlines the terminal's own background shows, so keep BASE close to a dark theme.
const BASE = hex('#0d1117'), SCANLINE = hex('#07090d');
const NEON = { 31: hex('#ff5c57'), 32: hex('#5af78e'), 33: hex('#f3f99d'), 34: hex('#82aaff'), 35: hex('#ff6ac1'), 36: hex('#9aedfe') };
const fg = ([r, g, b]) => `\x1b[38;2;${r};${g};${b}m`;
const bg = ([r, g, b]) => `\x1b[48;2;${r};${g};${b}m`;
const BAND = '\x03', BAND_UP = '\x04'; // rows paint() draws as shader bands, glowing down or up
const shaded = (s) => `\x01${s}\x02`; // text paint() colours with the shader
const fx = { shader: ONCE ? 'off' : 'aurora', effect: ONCE ? 'off' : 'bloom+scanlines' };
const cycle = (list, cur) => list[(list.indexOf(cur) + 1) % list.length];

// Turn one frame() row into what the terminal gets for row y of a w-wide screen.
function paint(line, y, w, t) {
  const shader = SHADERS[fx.shader], bloom = fx.effect.includes('bloom'), scan = fx.effect.includes('scanlines');
  const rowBg = scan ? bg(y % 2 ? SCANLINE : BASE) : '';
  const glow = (c, k = 0.12) => (bloom ? bg(mix(BASE, c, k)) : ''); // stronger reads as label chips, not a glow
  if (line === BAND || line === BAND_UP) {
    if (!shader) return rowBg + dim('─'.repeat(w - 1)) + rowBg + '\x1b[K';
    let s = '';
    for (let x = 0; x < w; x++) {
      const c = shader(x, y, t);
      s += bloom ? fg(c) + glow(c, 0.35) + (line === BAND ? '▀' : '▄') : fg(c) + rowBg + '━';
    }
    return s + '\x1b[0m';
  }
  let s = line.replace(/\x01([^\x02]*)\x02/g, (_, text, at, whole) => {
    if (!shader) return `\x1b[36m${text}\x1b[39;49m`;
    const x0 = vis(whole.slice(0, at)).length;
    return [...text].map((ch, i) => { const c = shader(x0 + i, y, t); return fg(c) + glow(c) + ch; }).join('') + '\x1b[39;49m';
  });
  if (bloom) s = s.replace(/\x1b\[(3[1-6])m/g, (_, n) => fg(NEON[n]) + glow(NEON[n]));
  if (scan) s = rowBg + s.replace(/\x1b\[(?:0|49|39;49)?m/g, (m) => m + rowBg); // resets drop the row colour; put it back
  // w - 1: erasing to end of line from the last column would wipe its character
  return clip(s, w - 1) + rowBg + '\x1b[K';
}

// ---- select: j/k pick an agent or an issue, enter jumps to the agent's pane or opens the issue's worktree
const MARK = cyan('▸ ');
let sel = null, flash = null; // sel is an agent's block ID or an issue's repo#number, so it survives refreshes
let handedOver = false; // wt has the terminal: nothing draws or reads keys until it exits
const agents = () => (state.fleet || []).flatMap((s) => s.panes).filter((p) => p.rec);
const issueKey = (i) => `${plain(i.repository.name)}#${i.number}`;
const say = (text) => { flash = { text, until: Date.now() + 4e3 }; draw(); };

function move(d) {
  const keys = [...agents().map((p) => p.blockId), ...(state.issues?.nodes || []).map(issueKey)];
  if (!keys.length) return;
  const i = keys.indexOf(sel);
  sel = keys[i < 0 ? 0 : Math.min(keys.length - 1, Math.max(0, i + d))];
  draw();
}

function open() {
  const p = agents().find((x) => x.blockId === sel);
  if (p) return jump(p);
  const i = state.issues?.nodes.find((x) => issueKey(x) === sel);
  if (i) return worktree(i);
  say(dim('pick an agent or issue with j/k first'));
}

async function jump(p) {
  try {
    // With several Rex apps connected, set REX_CLIENT to pick one.
    await sh('rex', ['do', 'session.select', `session_id=${p.sessionId}`, `window_id=${p.windowId}`]);
    await sh('rex', ['focus', '-s', p.sessionId, p.blockId]);
    say(green(`→ ${plain(p.session)}`));
  } catch (e) {
    say(red(plain(firstLine(e))));
  }
}

// `wt issue <number>` opens the issue's worktree by wt's rules: it offers the issue's <number>-* branches,
// or a new one named in a prompt, creates the worktree, runs wt.setupCommand and opens the worktree's
// session (in Rex, inside Rex). Its prompts and setup need the terminal, so the dashboard hands it over
// until wt exits, and keeps what a failing wt printed on screen until a key.
async function worktree(i) {
  if (!repo) return say(dim('start rex-dash in the repo to open a worktree for its issue'));
  handedOver = true;
  process.stdin.setRawMode(false).pause();
  process.stdout.write('\x1b[0m\x1b[?25h\x1b[?1049l');
  const end = await new Promise((resolve) => spawn('wt', ['issue', String(i.number)], { stdio: 'inherit' })
    .on('error', (error) => resolve({ error }))
    .on('exit', (code, signal) => resolve({ code, signal })));
  process.stdin.setRawMode(true).resume();
  if (!end.error && end.code !== 0) {
    process.stdout.write(`\n${dim(`wt ${end.signal ? `killed by ${end.signal}` : `exited with ${end.code}`} · press a key`)}`);
    await new Promise((resolve) => process.stdin.once('data', resolve));
  }
  process.stdout.write('\x1b[?1049h\x1b[?25l');
  handedOver = false;
  repaint();
  if (end.error) say(red(end.error.code === 'ENOENT' ? 'wt not found: brew install gugahoi/tap/wt' : plain(firstLine(end.error))));
}

function frame() {
  const section = (key, render, loading) =>
    state[key + 'Err'] ? [head(key.toUpperCase()), red('  ' + plain(state[key + 'Err']))] : state[key] ? render(state[key]) : [head(key.toUpperCase()), dim('  ' + loading)];
  const keys = `${dim('[j/k] select  [⏎] open  [s] shader')} ${shaded(fx.shader)}  ${dim('[e] fx')} ${shaded(fx.effect)}  ${dim('[r] refresh  [q] quit')}`;
  return [
    `${bold(shaded('REX // COCKPIT'))} ${dim('·')} ${repo ? `${bold(plain(repo.name))} ${dim('·')} ` : ''}${new Date().toString().slice(0, 21)}` +
      (stale.size ? `  ${dim(`cached ${ago(Math.min(...[...stale].map((k) => fetched[k])))}`)}` : '') +
      (flash && Date.now() < flash.until ? `  ${flash.text}` : ''),
    ...(ONCE ? [] : [keys, BAND]),
    ...section('fleet', renderFleet, 'asking Rex…'),
    ...section('usage', renderUsage, `reading ${tilde(PROJECTS)}…`),
    ...section('prs', renderPRs, 'asking GitHub…'),
    ...section('issues', renderIssues, 'asking GitHub…'),
  ].flatMap((l) => l.split('\n'));
}

// The rows that fit a screen h rows high, its last row left for the band. Below the title, keys and band,
// rows scroll up as far as the selection's two lines need to show.
function fit(rows, h) {
  const at = rows.findIndex((l) => l.startsWith(MARK));
  rows.splice(3, Math.min(at - 3, at + 2 - (h - 1))); // a negative count removes nothing
  return rows.slice(0, h - 1);
}

let prev = []; // what each row last showed, so unchanged rows aren't resent
function draw() {
  if (ONCE || handedOver) return;
  const w = process.stdout.columns || 100, h = process.stdout.rows || 50, t = performance.now() / 1000;
  const rows = fit(frame(), h);
  while (rows.length < h - 1) rows.push('');
  rows.push(BAND_UP);
  let out = '';
  rows.forEach((l, y) => {
    const s = paint(l, y, w, t);
    if (s !== prev[y]) out += `\x1b[${y + 1};1H${s}`;
    prev[y] = s;
  });
  if (out) process.stdout.write(out);
}
const repaint = () => { prev = []; process.stdout.write('\x1b[2J'); draw(); };

function refresh(key, fn) {
  if (!busy.has(key)) busy.set(key, (async () => {
    try { state[key] = await fn(); fetched[key] = Date.now(); delete state[key + 'Err']; } catch (e) { state[key + 'Err'] = firstLine(e); }
    busy.delete(key);
    stale.delete(key);
    if (key !== 'fleet') save(); // the fleet changes every few seconds: the others' saves, and quitting, take it along
    draw();
  })());
  return busy.get(key);
}

const SOURCES = { fleet: [fleet, 3e3], prs: [prs, 60e3], issues: [issues, 60e3], usage: [async () => usage(), 300e3] };
const refreshAll = () => Object.entries(SOURCES).map(([k, [fn]]) => refresh(k, fn));

const save = () => writeCache('state.json', {
  gh: repo?.gh, fetched, state: Object.fromEntries(Object.keys(SOURCES).filter((k) => state[k]).map((k) => [k, state[k]])),
});
function restore(saved) {
  for (const k of Object.keys(SOURCES)) {
    if (!saved?.state?.[k] || !saved.fetched?.[k]) continue;
    state[k] = saved.state[k]; fetched[k] = saved.fetched[k]; stale.add(k);
  }
}

async function main() {
  const dir = process.cwd();
  repo = await detectRepo(dir);
  cacheDir = path.join(CACHE, cacheKey(repo));
  const saved = readCache('state.json');
  if (repo) {
    // A cached GitHub name is used at once and checked behind it. If it changed, PRs and issues are
    // fetched again, after any fetch for the old name finishes.
    const check = githubName(dir);
    named(saved && 'gh' in saved ? saved.gh : await check);
    check.then((gh) => {
      if (gh === repo.gh) return;
      named(gh);
      for (const k of ['prs', 'issues']) Promise.resolve(busy.get(k)).then(() => refresh(k, SOURCES[k][0]));
    });
  }
  restore(saved);
  if (ONCE) {
    await Promise.all(refreshAll());
    save();
    return console.log(frame().map((l) => paint(l, 0, Infinity, 0)).join('\n'));
  }
  const quit = () => { save(); process.stdout.write('\x1b[0m\x1b[?25h\x1b[?1049l'); process.exit(0); };
  process.stdout.write('\x1b[?1049h\x1b[?25l');
  process.on('SIGINT', () => handedOver || quit()).on('SIGTERM', quit).on('SIGHUP', quit); // Ctrl-C in wt's setup is wt's
  process.stdout.on('resize', () => handedOver || repaint());
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true).resume().on('data', (chunk) => {
      // Keys typed quickly can arrive in one chunk, so handle them one at a time, until wt takes the terminal.
      for (const s of chunk.toString().match(/\x1b\[[A-D]|[\s\S]/g) || []) {
        if (handedOver) break;
        if (s === 'q' || s === '\x03') quit();
        if (s === 'r') refreshAll();
        if (s === 'j' || s === '\x1b[B') move(1);
        if (s === 'k' || s === '\x1b[A') move(-1);
        if (s === '\r') open();
        if (s === 's') { fx.shader = cycle(Object.keys(SHADERS), fx.shader); draw(); }
        if (s === 'e') { fx.effect = cycle(EFFECTS, fx.effect); draw(); }
      }
    });
  }
  draw();
  await refresh('fleet', fleet); // the usage scan blocks the event loop, so show the fleet first
  refreshAll();
  for (const [k, [fn, every]] of Object.entries(SOURCES)) setInterval(() => refresh(k, fn), every);
  setInterval(draw, 100); // 10 fps for the shader, and it keeps the clock and "ago" columns moving
}

