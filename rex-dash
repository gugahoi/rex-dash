  const pane = (blockId, title, session) => ({ session, blockId, prog: 'pi', cwd: '/r', title, rec: { state: 'working', updated_at: new Date().toISOString() } });
  state.fleet = [{ label: 'web', panes: [pane('b1', 'c-a-c-h-e rows', 'web')] }, { label: 'api', panes: [pane('b2', 'add auth', 'api')] }];
  state.issues = { issueCount: 2, nodes: [issue([]), { ...issue([]), number: 8, title: 'add cache' }] };
  setQuery('');
  for (const s of '/jk') press(s);
  assert.deepStrictEqual([typing, query], [true, 'jk']); // typed, not moves
  press('\x15'); // ctrl-u
  for (const s of 'cache') press(s);
  assert.deepStrictEqual([selectable().map((x) => x.key), sel], [['b1', 'r#8'], 'r#8']); // the best match, not the first
  press('\x1b[A'); // the arrows still select
  assert.strictEqual(sel, 'b1');
  press('\r');
  press('j');
  assert.deepStrictEqual([typing, query, sel], [false, 'cache', 'r#8']); // kept, and j moves among the matches
  const found = renderIssues(state.issues);
  assert.ok(vis(found[0]).endsWith('2 assigned to you · 1 match') && found.length === 3);
  assert.ok(found[1].includes('\x1b[4mc\x1b[24m\x1b[4ma\x1b[24m')); // matched characters are underlined
  assert.ok(!renderFleet(state.fleet).some((l) => vis(l) === 'api')); // a session with no matches goes
  for (const s of '/\x7f\x7f\x7f\x7f\x7fapi') press(s);
  assert.deepStrictEqual(selectable().map((x) => x.key), ['b2']); // a pane matches its session
  press('\x1b');
  assert.deepStrictEqual([typing, query, selectable().length], [false, '', 4]); // esc clears
  for (const s of '/x\r\x1b') press(s);
  assert.strictEqual(query, ''); // esc clears a kept filter too
  press('/'); press('\x7f');
  assert.strictEqual(typing, false); // backspace on an empty query leaves it
  // PRs are selectable too, the ones on screen, in screen order; a section showing an error has nothing to select.
  const pr = (number) => ({ number, title: 'a pr', isDraft: false, reviewDecision: null, updatedAt: new Date().toISOString(), repository: { name: 'r' }, commits: { nodes: [] } });
  state.prs = { review: { issueCount: 1, nodes: [pr(3)] }, mine: { issueCount: 12, nodes: Array.from({ length: 12 }, (_, k) => pr(20 + k)) } };
  assert.deepStrictEqual(selectable().map((x) => `${x.kind} ${x.key}`),
    ['agent b1', 'agent b2', 'pr r#3', ...Array.from({ length: 10 }, (_, k) => `pr r#${20 + k}`), 'issue r#7', 'issue r#8']);
  sel = 'r#3';
  assert.ok(prLine(pr(3)).startsWith(MARK) && !prLine(pr(20)).startsWith(MARK)); // the selected PR is marked
  state.prsErr = 'offline';
  assert.deepStrictEqual(selectable().map((x) => x.kind), ['agent', 'agent', 'issue', 'issue']);
  delete state.fleet; delete state.issues; delete state.prs; delete state.prsErr; sel = null;
  console.log('ok');
} else {
  main();
}
