#!/usr/bin/env node
'use strict';

// Keep this entry point executable in a checkout and in the Homebrew libexec tree.
if (process.argv.includes('--test')) {
  require('./lib/self-check').run();
} else {
  require('./lib/app').createApp({ once: process.argv.includes('--once') }).main().catch((e) => {
    console.error(e);
    process.exitCode = 1;
  });
}
